# SPQR WASM wrapper (docs/33): crate `spqr` DI-vendor di `vendor/signal/spqr`
# (build default), jadi artefak build `dist/spqr.wasm` tetap DI-commit supaya
# test & kapabilitas `spqr-ratchet` tetap jalan tanpa langkah build Rust di CI.
# Cargo.toml di-generate `build.sh` (memuat path crate yang dipilih) sehingga
# tidak di-commit; Cargo.lock ikut di-commit.
packages/spqr-wasm/target/
packages/spqr-wasm/Cargo.toml
# `cargo test` langsung di crate ter-vendor (docs/11 §11.3) meninggalkan target/.
vendor/signal/spqr/target/
!packages/spqr-wasm/dist/
!packages/spqr-wasm/dist/spqr.wasm

# Verifier Key Transparency v2 (docs/35 §35.7 Fase 7; satu-satunya verifier sejak
# log v1 pensiun, docs/38): crate fork lokal `packages/keytrans-v2`, artefak WASM
# tetap di-commit dan diverifikasi manifest. Cargo.toml wrapper di-generate
# `build.sh`.
packages/keytrans-v2/target/
packages/keytrans-wasm-v2/target/
packages/keytrans-wasm-v2/Cargo.toml
!packages/keytrans-wasm-v2/dist/
!packages/keytrans-wasm-v2/dist/keytrans-v2.wasm

# PIR client WASM (docs/35 Fase 4c): crate crates.io chalametpir-client,
# Cargo.toml di-generate build.sh; artefak dist tetap DI-commit dan diverifikasi manifest.
packages/pir-wasm/target/
packages/pir-wasm/Cargo.toml
!packages/pir-wasm/dist/
!packages/pir-wasm/dist/pir-client.wasm

# PIR sidecar (docs/35 Fase 4b): target Cargo dan snapshot direktori lokal
# mengandung record pengguna; keduanya artefak, bukan sumber.
server/pir-sidecar/target/
server/pir-snapshot.json

# Layanan log/tulis Key Transparency NYX v2 (docs/32 §32.8, docs/38): biner hasil
# build tidak di-commit (modul upstream-nya di-vendor di `server/kt-query/vendor/`,
# lihat NOTICE).
server/kt-query/nyx-kt-query-v2
server/kt-query/nyx-kt-auditor-v2
server/kt-query/nyx-kt-v2-init

# Oracle DR lintas-implementasi (`tools/dr-oracle`, docs/30 WS-G(6)): sumber Go
# di-commit, binernya tidak (`go build`/`go build ./...` meninggalkannya di sini).
tools/dr-oracle/nyx-dr-oracle

# [docs/30 WS-G(2)] Binari alat drill yang diunduh skrip (`promtool`,
