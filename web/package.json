  "name": "nyx-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/ping-indexnow.js",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ohttp": "playwright test --config playwright.ohttp.config.ts --project=chromium",
    "lint": "oxlint src",
    "test": "vitest run",
    "bench:backup": "NYX_BENCH=1 vitest run src/lib/__tests__/backupBench.test.ts",
    "bench:spqr": "NYX_BENCH=1 vitest run src/lib/__tests__/spqrBench.test.ts",
    "bench:search": "NYX_BENCH=1 vitest run src/lib/__tests__/searchBench.test.ts",
    "bench:pq": "NYX_BENCH=1 vitest run src/lib/__tests__/pqBench.test.ts",
    "build:pq-bench": "tsc -b && VITE_PQ_BENCH=1 vite build",
    "bench:pq:throttle": "NYX_PQ_THROTTLE=1 NYX_E2E_SKIP_RESET=1 playwright test e2e/pqBenchThrottle.spec.ts --project=chromium",
    "fuzz:parsers": "NYX_FUZZ_ITERS=50000 vitest run src/lib/__tests__/fuzzParsers.test.ts",
    "fuzz:parsers:hour": "NYX_FUZZ_SECONDS=3600 vitest run src/lib/__tests__/fuzzParsers.test.ts"
  },
  "dependencies": {
