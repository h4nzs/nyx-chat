// Datasource & Generator
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id               String  @id @default(uuid())
  usernameHash     String  @unique
  passwordHash     String
  encryptedProfile String? @db.Text

  hasCompletedOnboarding Boolean          @default(false)
  isVerified             Boolean          @default(false) // WebAuthn / Trust Tier status
  subscriptionTier       SubscriptionTier @default(FREE) // NYX Plus subscription status
  subscriptionExpiresAt  DateTime? // NYX Plus subscription expiry date

  // [CONTACT STORE P1 2026-10-05] SATU blob opaque per user — JSON ContactBundle
  // terenkripsi klien (XChaCha, kunci dari identity key; server TIDAK bisa
  // membaca). Kolom plain hanya version (hash isi, untuk fetch kondisional)
  // dan updatedAt. Backup "user yang pernah bertukar pesan" lintas device.
  encryptedContactBundle String? @db.Text
  contactBundleVersion   Int?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  role             String    @default("USER")
  bannedAt         DateTime?
  banReason        String?
  // [docs/28 Tier 2 — B4] Hari aktivitas terakhir (dipotong ke hari, UTC) —
  // dipakai dead man's switch. Presisi detik tak diperlukan & hanya menambah
  // pola temporal pada dump. Lihat utils/temporalBucket.ts.
  lastActiveDay    DateTime  @default(now())
  autoDestructDays Int?
  currentChallenge String?

  // --- RELASI PERANGKAT (DEVICE RECORDS) ---
  devices Device[]

  // --- RELASI PENGGUNA ---
  // [docs/28 D8/D9/D2] Story, BlockedUser, dan UserHiddenConversation TIDAK
  // punya relasi FK ke User: ketiganya memakai identity TER-SEAL
  // (authorTag / blockerTag+blockedTag / userId) supaya dump DB tidak
  // merekonstruksi graph sosial. Pembersihan saat akun dihapus dilakukan
  // eksplisit lewat purgeSealedUserRows (bukan cascade).
  // CATATAN (2026-10-09): relasi `hiddenConversations` sempat tertinggal →
  // kolom ter-seal ditolak FK `UserHiddenConversation_userId_fkey`
  // (P2003) sehingga baris keanggotaan tidak pernah dibuat.
  authenticators      Authenticator[]

  // --- MULTI-TENANCY (B2B BaaS) ---
  // [docs/28 Tier 1.5 / D4] `externalId` adalah identitas ASLI pelanggan B2B
  // (dari tenant) — disimpan TER-SEAL (AEAD deterministik) supaya dump tidak
  // memuat daftar identitas pelanggan, tetapi lookup `tenantId+externalId` dan
  // pengembalian nilai ke tenant tetap bekerja (unseal saat read).
  tenantId         String?
  tenant           Tenant? @relation(fields: [tenantId], references: [id])
  externalIdSealed String? @db.Text

  @@unique([tenantId, externalIdSealed])
  @@index([createdAt])
  @@index([autoDestructDays, lastActiveDay])
}

// ==========================================
// 🏢 TABEL BARU: TENANT (B2B BaaS)
// ==========================================
model Tenant {
  id             String   @id @default(uuid())
  name           String
  apiKey         String   @unique
  allowedDomains String[]
  isActive       Boolean  @default(true)

  users         User[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 📱 TABEL BARU: DEVICE (PERANGKAT)
// ==========================================
model Device {
  id     String @id @default(uuid())
  userId String
  // [docs/28 Tier 1.5] Label perangkat di-set KLIEN ("Chrome on MacOS") —
  // menyimpan plaintext = sidik jari platform presisi di dump. Disimpan
  // ter-seal; dibuka saat daftar sesi ditampilkan (routes/sessions.ts).
  nameSealed  String? @db.Text
  fingerprint String? // HMAC(pepper) — lihat utils/atRestSecrets.ts
  // [docs/28 Tier 1.5] Anchor instalasi persisten dari IndexedDB. Nilai mentah
  // (stabil lintas akun di browser yang sama) tidak pernah persist: yang
  // disimpan tag HMAC(pepper, "install:"+nilai) — perbandingan binding tetap
  // bekerja karena klien selalu mengirim nilai mentahnya.
  installationTag String?

  // Identitas Kriptografi (Pindahan dari tabel User)
  publicKey           Bytes // Encryption/Identity Key
  pqPublicKey         Bytes? // NEW: PQ Identity Key (ML-KEM)
  signingKey          Bytes // Verification Key
  encryptedPrivateKey Bytes?

  createdAt    DateTime @default(now())
  // [docs/28 Tier 2 — B4] Dipotong ke 15 menit (deviceActivityBucket()) supaya
  // dump tidak memuat jam aktivitas perangkat yang presisi; pembaca "device
  // terbaru" memakai tie-break createdAt.
  lastActiveAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relasi Sesi & Kriptografi terikat pada Perangkat
  preKeyBundle      PreKeyBundle?
  oneTimePreKeys    OneTimePreKey[]
  sessionKeys       SessionKey[]
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]

  @@index([userId])
  @@index([lastActiveAt])
}

model OneTimePreKey {
  id          String   @id @default(uuid())
  keyId       Int
  deviceId    String // Diubah dari userId
  publicKey   Bytes // Classical
  pqPublicKey Bytes? // NEW: Post-Quantum
  // [docs/28 Tier 2 — 2.4] `createdAt` DIHAPUS: baris OTPK sudah dihapus atomik
  // tepat saat dipakai (keys.ts: DELETE ... RETURNING), jadi tak ada riwayat
  // waktu. Urutan "paling tua dulu" kini memakai `keyId` (monotonik per batch)
  // — tanpa kolom timestamp yang bisa bocor ke dump.

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId])
}

model PreKeyBundle {
  id            Int    @id @default(autoincrement())
  identityKey   Bytes // Device's long-term public identity key
  pqIdentityKey Bytes? // NEW: PQ long-term public identity key
  key           Bytes // The public part of the signed pre-key
  pqKey         Bytes? // NEW: PQ signed pre-key
  signature     Bytes // Signature of the 'key'
  pqSignature   Bytes? // NEW: Signature of the 'pqKey'

  deviceId String @unique // Diubah dari userId
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id            String        @id @default(uuid())
  jti           String        @unique
  familyId      String        @default("legacy") // Groups tokens from the same original session (rotation chain). Default for legacy tokens pre-migration.
  deviceId      String // Sesi login diikat ke Perangkat
  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // [docs/28 Tier 0 — D5] ipAddress & userAgent DIHAPUS: IP di-hash tanpa kunci
  // (enumerable: IPv4 hanya 2^32) dan userAgent tersimpan plaintext — keduanya
  // metadata perangkat/sesi yang tak dibutuhkan fungsional. Daftar sesi kini
  // memakai `Device.name` + flag `isCurrent` (lihat routes/sessions.ts).
  revokedAt     DateTime?
  replacedById  String?       @unique // Points to the previous token in this family chain
  replacedBy    RefreshToken? @relation("TokenReplacement", fields: [replacedById], references: [id])
  replacedToken RefreshToken? @relation("TokenReplacement")
  createdAt     DateTime      @default(now())
  lastUsedAt    DateTime      @updatedAt
  expiresAt     DateTime

  @@index([deviceId])
  @@index([expiresAt])
  @@index([familyId])
  @@index([jti])
  @@index([revokedAt])
}

model SessionKey {
  id                   String       @id @default(uuid())
  conversationId       String
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade) // INI YANG DITAMBAHKAN
  sessionId            String
  deviceId             String // Session key E2EE diikat antar perangkat
  device               Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  isInitiator          Boolean      @default(false)
  encryptedKey         Bytes
  initiatorCiphertexts Bytes?
  createdAt            DateTime     @default(now())
  expiresAt            DateTime?

  @@unique([deviceId, sessionId])
  @@index([conversationId, deviceId, sessionId])
  @@index([expiresAt]) // System Sweeper: filter session key kadaluarsa (harian)
}

model PushSubscription {
  id String @id @default(uuid())
  // [docs/28 Tier 1.5 / D10] `endpoint` FCM/APNs adalah identifier perangkat
  // (dan korelasinya lintas akun). Disimpan TER-SEAL (AEAD deterministik) supaya
  // dump tidak memuatnya, tetapi uniqueness + lookup `where endpoint` tetap
  // bekerja (seal nilai yang datang dari klien); endpoint asli dibuka hanya saat
  // mengirim push (utils/sendPushNotification.ts).
  endpointSealed String @unique @db.Text
  p256dh         String
  auth           String
  deviceId       String // Push Token Notifikasi diikat per-Perangkat
  createdAt      DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

model Conversation {
  id                String  @id @default(uuid())
  isGroup           Boolean @default(false)
  encryptedMetadata String?
  authSecret        String? // Secret token for blind authorization (Opaque Mailbox)
  // [26.9 RBAC] SHA-256 hex dari admin capability token. Server TIDAK menyimpan
  // token-nya (hanya hash) — kepemilikan token = bukti role ADMIN/OWNER tanpa
  // server tahu roster/role. Hash boleh plaintext-kolom (input 256-bit random).
  adminSecretHash   String?

  // [docs/28 Tier 2 — B1] Counter monotonik per-conversation untuk `Message.seq`.
  // Di-increment atomik (Prisma `increment`) setiap pesan dibuat; urutan pesan
  // TIDAK lagi bergantung pada jam dinding (`Message.createdAt`), sehingga
  // createdAt boleh dikasar (B3) tanpa merusak urutan/scroll-history.
  messageSeq        Int     @default(0)

  // --- MULTI-TENANCY (B2B BaaS) ---
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  // [docs/28 Tier 1.5 / D4] `metadata Json?` (JSON bebas dari tenant) DIHAPUS:
  // server tidak pernah membacanya (write-only di engine.ts) tetapi dump bisa
  // memuat plaintext apa pun yang ditulis tenant. Tidak ada konsumen → kolom
  // dibuang, bukan di-seal.

  lastMessageAt DateTime?                @db.Timestamptz(6)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  messages      Message[]
  sessionKeys   SessionKey[]
  hiddenBy      UserHiddenConversation[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([createdAt])
  @@index([isGroup])
}

enum MessageType {
  USER
  SYSTEM
}

enum SubscriptionTier {
  FREE
  SUBSCRIBER
}

model Message {
  // [docs/28 Tier 2 — B5] id NON-time-ordered (uuid v4). `cuid()` menyematkan
  // waktu (monotonik) sehingga dump DB bisa mengurutkan/menebak waktu walau
  // createdAt dikasar. Klien memperlakukan id sebagai opaque string.
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  // [T1 GROUP PSEUDONYMS] Bukan FK ke User: pesan grup v2 mem-persist
  // PSEUDONYM di kolom ini (opaque); 1:1 selalu NULL (sealed sender).
  senderId       String?
  content        String?      @db.Text
  type           MessageType  @default(USER)
  deleteSecret   String? // Secret token for blind deletion authorization

  sessionId           String?
  encryptedSessionKey String?
  // [docs/28 Tier 2 — B1] Urutan monotonik per-conversation (dari
  // `Conversation.messageSeq`). 0 = baris legacy/backfill belum jalan.
  seq                 Int             @default(0)
  createdAt           DateTime        @default(now())
  statuses            MessageStatus[]
  expiresAt           DateTime?
  isViewOnce          Boolean         @default(false)
  isViewed            Boolean         @default(false)

  // [docs/28 Tier 2 — 2.2] TER-SEAL (sealAtRest): dump DB tidak memuat edge
  // balasan. Mapper mengosongkan field ini dan pemanggil read membukanya via
  // resolveRepliedToId(); baris legacy plaintext tetap terbaca.
  repliedToId String? @map("replied_to_id")

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, seq(sort: Desc)])
  @@index([senderId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([repliedToId])
  @@index([expiresAt]) // Message Sweeper: filter expiresAt <= now setiap menit
}

enum DeliveryStatus {
  SENT
  DELIVERED
  READ
}

model MessageStatus {
  id        String         @id @default(uuid())
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  // [T3a + docs/28 Tier 1.1 — D2] Bukan FK ke User. Grup v2 menyimpan
  // PSEUDONYM dari klien (opaque, unlinkable). 1:1 & grup v1 menyimpan
  // `conversationScopedTag` (HMAC per-conversation, lihat utils/atRestSecrets.ts)
  // — userId asli TIDAK pernah persist, sehingga dump DB tidak bisa
  // merekonstruksi "siapa membaca pesan apa".
  userId    String
  status    DeliveryStatus @default(SENT)
  // [docs/28 Tier 2 — B3] coarse (dipotong 15 mnt). `@updatedAt` dihapus karena
  // Prisma akan menimpa dengan waktu presisi; nilai ditulis EKSPLISIT oleh kedua
  // jalur receipt (realtimeHandlers) via messageTimeBucket().
  updatedAt DateTime

  @@unique([messageId, userId])
  @@index([userId, status])
  @@index([messageId])
  @@index([status])
  @@index([updatedAt])
}

model UserHiddenConversation {
  id             String       @id @default(uuid())
  // [T3b TOKEN-FIRST — doc 26.2/26.8.1] Membership/discovery bar = POSES
  // TOKEN, bukan join userId. `userId` nullable & HANYA untuk routing internal
  // (relay pesan, push, sweeper) — tidak pernah dipakai untuk discovery.
  // Trigger #1 upgrade 26.8.1 (token-only endpoints) kini tertutup.
  // [docs/28 Tier 1.2 — D2] Nilai kolom = routing identity TER-SEAL
  // (sealAtRest, kunci dari NYX_AT_REST_PEPPER), bukan userId asli. Server tetap
  // membukanya untuk routing internal (utils/routingIdentity.ts), tetapi dump DB
  // sendirian tidak memuat daftar keanggotaan.
  // PENTING: TANPA relasi/FK ke `User` — nilainya ter-seal (bukan id asli),
  // jadi FK pasti dilanggar (P2003). Pembersihan saat akun dihapus lewat
  // `purgeSealedUserRows` (lihat utils/routingIdentity.ts).
  userId         String?
  conversationId String
  // Opaque per-(group, member) delivery token. Wajib: setiap baris keanggotaan
  // diterbitkan klien (creator) — server tidak bisa membuatnya sendiri.
  deliveryToken  String       @unique
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

// [26.8.1 ZKGROUP-STYLE CREDENTIALS — blind RSA / RFC 9474]
// Serial 64-hex dari credential yang SUDAH diterbitkan server (blind-signed).
// Disimpan untuk: (a) dedupe issuance, (b) presentasi = cek keanggotaan.
// Serial tidak membawa identitas — klien yang membawa (msg, sig) valid dianggap
// anggota. Baris dihapus saat revocation (kick/leave) → credential mati.
model GroupCredential {
  id             String   @id @default(uuid())
  serial         String   @unique // 64-hex = SHA-384 dari prepared message
  conversationId String
  keyVersion     Int // versi issuer key yang menandatangani
  issuedAt       DateTime @default(now())

  @@index([conversationId])
}

// State issuer key blind RSA. Satu row aktif (keyVersion tertinggi).
// [docs/28 Tier 0 — D1 KRITIS] PRIVATE key TIDAK BOLEH ada di DB: dump DB =
// akar kepercayaan keanggotaan grup ikut bocor (siapa pun bisa menandatangani
// credential → masuk grup mana pun). Private key hidup di env
// `GROUP_ISSUER_KEY_PKCS8` (opsional: file dev 0600 di server/.nyx-issuer-key),
// lihat lib/groupCredentials.ts + scripts/issuer-key.ts. Row ini hanya memuat
// material PUBLIK (untuk verifikasi presentasi & distribusi ke klien).
model CredentialIssuerKey {
  keyVersion      Int      @id
  publicKeyJwk    String // JSON Web Key (public) — dibagikan ke klien
  createdAt       DateTime @default(now())
}

model Authenticator {
  id                   String  @id
  credentialID         String  @unique
  userId               String
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialPublicKey  String
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  @@index([userId])
}

// [docs/28 Tier 1.3 — D9] Bukan FK ke User lagi: pasangan (blocker, blocked)
// kini memakai identity TER-SEAL (sealAtRest, kunci dari NYX_AT_REST_PEPPER).
// Server tetap bisa menurunkan "siapa diblokir siapa" untuk fungsionalitas
// (list blocked, story gating, unblock), tetapi dump DB tidak lagi memuat graph
// permusuhan dalam bentuk identitas.
// [2026-10 legacy purge] NOT NULL: dulu nullable demi `prisma db push` di tabel
// berisi baris lama (NULL = baris legacy). Tidak ada lagi baris tanpa tag.
model BlockedUser {
  id         String   @id @default(uuid())
  blockerTag String
  blockedTag String
  createdAt  DateTime @default(now())

  @@unique([blockerTag, blockedTag])
  @@index([blockerTag])
  @@index([blockedTag])
}

// [docs/28 Tier 1.3 — D8] Bukan FK ke User lagi: penulis disimpan sebagai
// `authorTag` TER-SEAL (sealAtRest). Dulu `senderId` adalah FK asli → dump DB
// memberi "siapa membuat story kapan" tanpa perlu membukanya. Endpoint tetap
// mengembalikan `senderId` asli (di-resolve server saat request) supaya kontrak
// klien tidak berubah.
// [2026-10 legacy purge] NOT NULL — alasan nullable yang sama dengan BlockedUser
// (migrasi tabel berisi baris lama) sudah tidak berlaku.
model Story {
  id               String   @id @default(uuid())
  authorTag        String
  encryptedPayload String   @db.Text
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([authorTag])
  @@index([expiresAt])
}
