# Backend
# [docs/10 / R6 2026-10-15] Pengaman /api/admin/cleanup (destruktif: menghapus
# baris, termasuk akun dorman). ADMIN_CLEANUP_SECRET sangat disarankan terpisah
# dari CHAT_SECRET; kosong → fallback CHAT_SECRET + peringatan boot.
# ADMIN_CLEANUP_IP_ALLOWLIST = CSV IP yang boleh memanggilnya; kosong = tanpa
# batasan IP. Diperiksa SEBELUM kunci dibandingkan.
ADMIN_CLEANUP_IP_ALLOWLIST=
ADMIN_CLEANUP_SECRET=
APP_URL=https://api.nyx-app.my.id
# [docs/31 §31.6 fase 3] Rahasia HMAC untuk menurunkan kunci objek backup R2
# (tanpa userId di kunci objek). Sebaiknya nilai independen yang STABIL di
# production; bila kosong, jatuh ke JWT_SECRET (dengan peringatan startup) dan
# rotasi JWT_SECRET akan membuat backup awan lama tak bisa ditemukan lagi.
BACKUP_KEY_SECRET=YOUR-BACKUP-KEY-SECRET
CHAT_SECRET=YOUR-SUPER-SECRET
CORS_ORIGIN=http://localhost:3000
CSRF_SECRET=YOUR-CSRF-SECRET
DATABASE_URL=postgresql://*:@localhost:5432/nyx_app
DIRECT_URL=postgresql://*:@localhost:5432/nyx_app?sslmode=disable
DISCORD_REPORT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR-WEBHOOK-URL
# [docs/28 Tier 0.1] Private key issuer blind RSA grup (base64 PKCS#8).
# WAJIB di production — key TIDAK disimpan di DB (dump DB dulu = bisa memalsukan
# keanggotaan grup). Buat dengan: pnpm --filter nyx-server run issuer-key:generate.
# Rotasi: naikkan GROUP_ISSUER_KEY_VERSION (row publik dibuat otomatis).
GROUP_ISSUER_KEY_PKCS8=
GROUP_ISSUER_KEY_VERSION=1
JWT_SECRET=YOUR-JWT-SECRET
# [R2 2026-10-15] Versi klien minimum yang boleh bicara dengan server ini
# (HTTP 426 CLIENT_TOO_OLD bila klien melaporkan versi lebih kecil). Kosong =
# gerbang mati. Klien yang tidak mengirim header versi selalu lolos, jadi
# naikkan angka ini hanya setelah klien lama sudah tidak dipakai.
MIN_CLIENT_VERSION=
# [BUGFIX 2026-10-18] Jendela toleransi (ms) untuk refresh token yang disajikan
# ULANG oleh klien yang sama setelah rotasi (respons hilang / timeout 30 s / tab
# di-freeze). Hanya berlaku bila token itu adalah pendahulu LANGSUNG dari token
# hidup terbaru di family yang sama; di luar jendela ini tetap dianggap replay
# token dan family di-revoke. Default 120000 (2 menit), maksimum 24 jam.
REFRESH_REPLAY_GRACE_MS=120000
# [docs/28 Tier 0] Pepper untuk hash identifier at-rest (blind index username,
# IP, fingerprint perangkat) + key seal deterministik (Tenant.apiKey, routing).
# WAJIB di production; JANGAN simpan di DB/backup — kalau pepper bocor, dump DB
# bisa dibalik lagi. Rotasi pepper = identifier lama tidak lagi cocok.
NYX_AT_REST_PEPPER=YOUR-RANDOM-PEPPER-32-BYTE
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
TRANSPORT_PORT=33333
CF_ACCOUNT_ID=YOUR-CLOUDFLARE-ACCOUNT-ID
CF_TURN_KEY_ID=YOUR-CLOUDFLARE-TURN-KEY-ID
CF_TURN_API_TOKEN=YOUR-CLOUDFLARE-TURN-API-TOKEN
# STUN milik operator (opsional, dipisah koma). Kosong = tidak ada fallback STUN
# sama sekali; kegagalan TURN menjadi 503/502 yang terlihat (docs/29 §5.7).
ICE_STUN_URLS=stun:turn.example.com:3478
# [docs/30 WS-E(1)] coturn self-host = PRIMER. Setel TURN_STATIC_AUTH_SECRET
# (nilai `static-auth-secret` coturn) + TURN_URLS agar server menerbitkan
# kredensial HMAC time-limited; Cloudflare TURN di bawah hanya cadangan.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_STATIC_AUTH_SECRET=YOUR-COTURN-STATIC-AUTH-SECRET
TURN_TTL=600
# [docs/30 WS-H] Guard burst registrasi per sumber (IP ter-HMAC, bukan IP mentah)
# & per instalasi. 'on' = aktif; kosong/off = no-op (rollback tanpa deploy logika).
ABUSE_REGISTRATION_GUARD=off
# [docs/30 WS-H] Tabel prefix→ASN LOKAL (CSV: `prefix,asn`). Kosong = nonaktif.
ASN_DB_FILE=
# [docs/30 WS-H] 'on' = semua akun baru wajib attestation perangkat keras.
ABUSE_REQUIRE_ATTESTATION=off
ABUSE_ATTESTATION_FORMATS=packed,tpm,android-key,apple,fido-u2f
ABUSE_ATTESTATION_BLOCKED_AAGUIDS=
ABUSE_ATTESTATION_ALLOW_SELF=off
# 'on' = terima attestation `none` (passkey tersinkron Google/Apple, alur default
# Android/iOS). Gate lalu hanya membuktikan authenticator ber-UV, bukan perangkat
# keras; akun hasil jalur ini dibuat dengan isVerified=false. Wajib juga
# menambahkan `none` ke ABUSE_ATTESTATION_FORMATS.
ABUSE_ATTESTATION_ALLOW_NONE=off
# 'on' = terima authenticator `multiDevice` (passkey tersinkron). Berdiri sendiri:
# tanpa ALLOW_NONE, passkey tetap ditolak karena `fmt: none`.
ABUSE_ATTESTATION_ALLOW_SYNCED=off
# 'on' = perangkat yang TIDAK punya authenticator sama sekali (desktop Linux
# tanpa Touch ID/Windows Hello dan tanpa security key) boleh mendaftar tanpa
# bukti. Akun tersebut isVerified=false (upload & pencarian luas tetap tertutup),
# dan heuristik burst sybil per-ASN TIDAK bisa memakai jalur ini.
ABUSE_ATTESTATION_ALLOW_UNATTESTED=off
# Rantai x5c wajib terverifikasi (tersambung, valid, berakhir di root yang
# dipin ATAU sertifikat self-signed yang dipin persis). 'on' = lewati — hanya
# untuk test (self-signed buatan siapa pun diterima sebagai "hardware").
ABUSE_ATTESTATION_ALLOW_UNVERIFIED_CHAIN=off
# Fingerprint SHA-256 root attestation yang dipercaya (dipisah koma). Cukup bila
# root ikut di x5c / cert self-signed dipin persis; TIDAK cukup bila x5c hanya
# leaf + intermediate (perangkat nyata) — pakai ROOTS_FILE.
ABUSE_ATTESTATION_ROOTS=
# Bundle PEM root attestation vendor (lihat ops/attestation/README.md).
ABUSE_ATTESTATION_ROOTS_FILE=
# Metadata bundle root dari `node scripts/attestation-roots.mjs refresh`
# (default: <ABUSE_ATTESTATION_ROOTS_FILE>.meta.json) — sumber peringatan boot
# dan gauge nyx_attestation_roots_* (nextUpdate MDS / root kedaluwarsa).
ABUSE_ATTESTATION_ROOTS_META=
# `fmt: 'tpm'` wajib ber-EKU AIK TPM. 'on' = tidak diwajibkan.
ABUSE_ATTESTATION_ALLOW_NO_AIK_EKU=off
# [docs/30 WS-A / docs/32] Endpoint gRPC test-update log Key Transparency v2.
# Dilayani `server/kt-query` → binary `nyx-kt-query-v2` (pemilik tunggal basis
# data KT). Kosong = penulisan log nonaktif. `KT_SERVER_URL` (v1) sudah pensiun
# sejak 2026-10-28 (docs/38): kalau masih ada, server hanya mencatat peringatan.
KT_V2_SERVER_URL=
KT_TIMEOUT_MS=5000
# [docs/32 §32.8] Layanan baca KT NYX (loopback, mis. http://127.0.0.1:8089).
# Kosong = /api/keys/kt/* → 503 KT_QUERY_DISABLED (degradasi terlihat).
# Menunjuk layanan v1 = semua verdict `unavailable` (klien hanya menerima ABI 2).
KT_QUERY_URL=
KT_QUERY_TIMEOUT_MS=5000
# [docs/10 §10.13] Direktori arsip snapshot log KT yang dibuat `nyx-kt-query-v2`
# (`-snapshot-dir` / `NYX_KT_V2_SNAPSHOT_DIR` di service itu). Server mengunggah
# arsip terbaru ke R2 tiap 03:30 dan menegakkan retensi 30 hari. Kosong = tidak
# ada arsip yang diunggah (terlihat di log + metrik nyx_kt_snapshot_upload_total).
KT_SNAPSHOT_DIR=
R2_ACCESS_KEY_ID=YOUR-R2-ACCESS-KEY-ID
R2_ACCOUNT_ID=YOUR-R2-ACCOUNT-ID
R2_BUCKET_NAME=YOUR-R2-BUCKET-NAME
R2_PUBLIC_DOMAIN=YOUR-R2-PUBLIC-DOMAIN
R2_SECRET_ACCESS_KEY=YOUR-R2-SECRET-ACCESS-KEY
# Observability (docs/10 §10.12, docs/30 WS-G). Loopback-only; 0 = matikan exporter.
# pm2 worker N memakai METRICS_PORT + NODE_APP_INSTANCE * 10 (9464, 9474, ...).
METRICS_HOST="127.0.0.1"
METRICS_PORT=9464
REDIS_URL="redis://127.0.0.1:6379"
TURNSTILE_SECRET_KEY=YOUR-TURNSTILE-SECRET-KEY
UPLOAD_DIR=uploads // optional if the user upload saved in localstorage or you dont have any cf storage bucket (you might have to change the upload logic code to the localstorage e.g attachment, user/group avatar, and story), default is "uploads"
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_SUBJECT="mailto:YOUR@MAIL.COM"

# Payments (crypto-only — NOWPayments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=


# Frontend
VITE_API_URL=http://localhost:4000
VITE_APP_SECRET=
VITE_VAPID_PUBLIC_KEY=
VITE_TRANSPORT_CERT_HASH= # Required for WebTransport on localhost (get it from server/transport-sidecar output)
INDEXNOW_API_KEY=
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
