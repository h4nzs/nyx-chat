---
import MainLayout from '../layouts/MainLayout.astro';
import Footer from '../components/Footer.astro';
import '../index.css';
import { getLangFromUrl, useTranslations } from '../utils/i18n';
import { FiArrowLeft, FiShield, FiLock, FiDatabase, FiGlobe, FiAlertTriangle } from 'react-icons/fi';

const { lang: propLang } = Astro.props;
const lang = propLang || Astro.currentLocale || getLangFromUrl(Astro.url);
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = useTranslations(lang);

const title = t('privacy:seo.title');
const description = t('privacy:seo.description');

const techArticleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "NYX Security Architecture & Zero-Knowledge Protocol",
  "alternativeHeadline": "How NYX protects metadata without storing user identities",
  "author": { "@type": "Organization", "name": "NYX Project" },
  "keywords": "Signal Protocol, Argon2, Zero-Knowledge, End-to-End Encryption, Privacy",
  "articleBody": "NYX uses a Double Ratchet algorithm...",
  "datePublished": "2026-03-01"
});

const navItems = [
  { id: 'privacy', label: t('privacy:nav.privacy') },
  { id: 'terms', label: t('privacy:nav.terms') },
  { id: 'licensing', label: t('privacy:nav.licensing') },
  { id: 'cookies', label: t('privacy:nav.cookies') },
  { id: 'security', label: t('privacy:nav.security') },
];
---

<MainLayout title={title} description={description} canonicalUrl={Astro.url.pathname} schemaMarkup={techArticleSchema}>
  <div class="min-h-screen bg-bg-main text-text-primary font-sans relative overflow-x-clip">

    <header class="sticky top-0 z-50 bg-bg-surface/80 backdrop-blur-xl border-b border-text-secondary/10">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href={lang === 'en' ? '/' : langPrefix} class="flex items-center gap-2 text-text-secondary hover:text-accent transition-colors text-sm font-bold tracking-wide uppercase">
          <FiArrowLeft size={16} /> {t('privacy:back')}
        </a>
        <div class="font-mono text-[10px] text-text-secondary uppercase tracking-[0.2em] flex items-center gap-2">
          <span class="icon-well w-7 h-7"><FiShield size={13} /></span>
          {t('privacy:title')}
        </div>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-12 flex flex-col md:flex-row gap-12 relative">
      <aside class="md:w-64 flex-shrink-0 hidden md:block">
        <nav class="sticky top-28 card-neumorphic-flat p-4 space-y-2" id="toc-nav">
          {navItems.map((item) => (
            <a href={`#${item.id}`} class="nav-link block w-full text-left px-4 py-2.5 rounded-xl text-sm font-bold transition-all duration-300 text-text-secondary hover:bg-bg-surface hover:text-text-primary">
              {item.label}
            </a>
          ))}
        </nav>
      </aside>

      <div class="flex-1 min-w-0">
        <div class="mb-16">
          <h1 class="font-display font-bold text-4xl sm:text-5xl mb-4 tracking-tight leading-tight">{t('privacy:title')}</h1>
          <p class="text-lg text-text-secondary max-w-2xl leading-relaxed">{t('privacy:subtitle')}</p>
          <div class="mt-6 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-bg-surface text-accent text-xs font-mono font-bold" style="box-shadow: var(--shadow-neu-icon)">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            {t('privacy:last_updated')}
          </div>
        </div>

        <section id="privacy" class="mb-14 scroll-mt-28 content-section">
          <div class="flex items-center gap-4 mb-6">
            <div class="icon-well w-12 h-12 flex-shrink-0"><FiLock size={22} /></div>
            <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight">{t('privacy:privacy.title')}</h2>
          </div>
          <div class="max-w-none text-text-secondary leading-relaxed">
            <p class="text-lg text-text-primary font-medium mb-4">{t('privacy:privacy.intro')}</p>
            <h3 class="font-display text-lg font-bold text-text-primary mt-8 mb-3 border-b border-text-secondary/10 pb-2">{t('privacy:privacy.minimization_title')}</h3>
            <ul class="list-disc pl-5 space-y-3">
              <li set:html={t('privacy:privacy.minimization_1')} />
              <li set:html={t('privacy:privacy.minimization_2')} />
              <li set:html={t('privacy:privacy.minimization_3')} />
              <li set:html={t('privacy:privacy.minimization_4')} />
              <li set:html={t('privacy:privacy.minimization_5')} />
            </ul>

            <h3 class="font-display text-lg font-bold text-text-primary mt-8 mb-3 border-b border-text-secondary/10 pb-2">{t('privacy:privacy.logging_title')}</h3>
            <p>{t('privacy:privacy.logging_desc')}</p>
            <ul class="list-disc pl-5 space-y-2 mt-2">
              <li>{t('privacy:privacy.logging_1')}</li>
              <li>{t('privacy:privacy.logging_2')}</li>
              <li>{t('privacy:privacy.logging_3')}</li>
            </ul>

            <h3 class="font-display text-lg font-bold text-text-primary mt-8 mb-3 border-b border-text-secondary/10 pb-2">{t('privacy:privacy.zero_telemetry_title')}</h3>
            <p set:html={t('privacy:privacy.zero_telemetry_desc')} />
          </div>
        </section>

        <section id="terms" class="mb-14 scroll-mt-28 content-section">
          <div class="flex items-center gap-4 mb-6">
            <div class="icon-well w-12 h-12 flex-shrink-0"><FiGlobe size={22} /></div>
            <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight">{t('privacy:terms.title')}</h2>
          </div>
          <div class="max-w-none text-text-secondary leading-relaxed">

            <div class="bg-red-500/5 border border-red-500/15 rounded-2xl p-6 mb-6">
              <h3 class="flex items-center gap-2 text-red-500 font-bold mb-2">
                <FiAlertTriangle /> {t('privacy:terms.liability_title')}
              </h3>
              <div class="text-sm text-red-600/90 dark:text-red-400/90 leading-relaxed">
                <p class="mb-3" set:html={t('privacy:terms.liability_desc')}></p>

                <p class="block mt-3 border-t border-red-500/15 pt-3">
                  {t('privacy:terms.help_guidance')}
                  <a href={`${langPrefix}/help`} class="text-accent underline hover:text-text-primary font-semibold">
                    {t('common:help')}
                  </a>.
                </p>
              </div>
            </div>

            <ul class="list-disc pl-5 space-y-4">
              <li set:html={t('privacy:terms.gating')} />
              <li set:html={t('privacy:terms.abuse')} />
            </ul>
          </div>
        </section>

        <section id="licensing" class="mb-14 scroll-mt-28 content-section">
          <div class="flex items-center gap-4 mb-6">
            <div class="icon-well w-12 h-12 flex-shrink-0"><FiShield size={22} /></div>
            <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight">{t('privacy:licensing.title')}</h2>
          </div>
          <div class="max-w-none text-text-secondary leading-relaxed">
            <p set:html={t('privacy:licensing.intro')} />
            <h3 class="font-display text-lg font-bold text-text-primary mt-6 mb-3">{t('privacy:licensing.agpl_title')}</h3>
            <p set:html={t('privacy:licensing.agpl_desc')} />

            <div class="card-neumorphic-flat p-6 mt-6">
              <h3 class="font-display font-bold text-text-primary mb-2 text-lg">{t('privacy:licensing.commercial_title')}</h3>
              <p class="text-sm mb-5 text-text-secondary leading-relaxed">
                {t('privacy:licensing.commercial_desc')}
              </p>
              <a href={`${langPrefix}/commercial`} class="btn-primary inline-flex text-sm">
                {t('privacy:licensing.contact_btn')}
              </a>
            </div>
          </div>
        </section>

        <section id="cookies" class="mb-14 scroll-mt-28 content-section">
          <div class="flex items-center gap-4 mb-6">
            <div class="icon-well w-12 h-12 flex-shrink-0"><FiDatabase size={22} /></div>
            <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight">{t('privacy:cookies.title')}</h2>
          </div>
          <div class="max-w-none text-text-secondary leading-relaxed">
            <p class="mb-4">{t('privacy:cookies.intro')}</p>

            <div class="card-neumorphic-flat p-2 overflow-x-auto">
              <table class="w-full text-left text-sm whitespace-nowrap">
                <thead class="bg-bg-main text-text-secondary text-xs uppercase tracking-wider">
                  <tr>
                    <th class="p-4 font-bold">{t('privacy:cookies.table_type')}</th>
                    <th class="p-4 font-bold">{t('privacy:cookies.table_item')}</th>
                    <th class="p-4 font-bold">{t('privacy:cookies.table_purpose')}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-text-secondary/10 text-text-secondary">
                  <tr class="hover:bg-bg-main transition-colors">
                    <td class="p-4"><span class="px-2 py-1 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs">HttpOnly Cookie</span></td>
                    <td class="p-4 font-mono text-accent">at / rt / csrf</td>
                    <td class="p-4">{t('privacy:cookies.cookie_desc')}</td>
                  </tr>
                  <tr class="hover:bg-bg-main transition-colors">
                    <td class="p-4"><span class="px-2 py-1 rounded bg-purple-500/10 text-purple-600 dark:text-purple-400 text-xs">IndexedDB</span></td>
                    <td class="p-4 font-mono text-accent">nyx_vault / keys</td>
                    <td class="p-4">{t('privacy:cookies.idb_keys_desc')}</td>
                  </tr>
                  <tr class="hover:bg-bg-main transition-colors">
                    <td class="p-4"><span class="px-2 py-1 rounded bg-purple-500/10 text-purple-600 dark:text-purple-400 text-xs">IndexedDB</span></td>
                    <td class="p-4 font-mono text-accent">shadow_vault</td>
                    <td class="p-4">{t('privacy:cookies.idb_vault_desc')}</td>
                  </tr>
                  <tr class="hover:bg-bg-main transition-colors">
                    <td class="p-4"><span class="px-2 py-1 rounded bg-orange-500/10 text-orange-600 dark:text-orange-400 text-xs">Persistent Storage</span></td>
                    <td class="p-4 font-mono text-accent">deviceId / installationId</td>
                    <td class="p-4">{t('privacy:cookies.id_desc')}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="security" class="mb-14 scroll-mt-28 content-section">
          <div class="flex items-center gap-4 mb-6">
            <div class="icon-well w-12 h-12 flex-shrink-0"><FiShield size={22} /></div>
            <h2 class="font-display text-2xl md:text-3xl font-bold tracking-tight">{t('privacy:security.title')}</h2>
          </div>
          <div class="max-w-none text-text-secondary leading-relaxed">
            <p>{t('privacy:security.intro')}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
              <div class="card-neumorphic-flat p-5">
                <h3 class="font-display font-bold text-text-primary mb-1">{t('privacy:security.signal_title')}</h3>
                <p class="text-xs text-text-secondary leading-relaxed">{t('privacy:security.signal_desc')}</p>
              </div>
              <div class="card-neumorphic-flat p-5">
                <h3 class="font-display font-bold text-text-primary mb-1">{t('privacy:security.webauthn_title')}</h3>
                <p class="text-xs text-text-secondary leading-relaxed">{t('privacy:security.webauthn_desc')}</p>
              </div>
              <div class="card-neumorphic-flat p-5">
                <h3 class="font-display font-bold text-text-primary mb-1">{t('privacy:security.memory_title')}</h3>
                <p class="text-xs text-text-secondary leading-relaxed">{t('privacy:security.memory_desc')}</p>
              </div>
              <div class="card-neumorphic-flat p-5">
                <h3 class="font-display font-bold text-text-primary mb-1">{t('privacy:security.migration_title')}</h3>
                <p class="text-xs text-text-secondary leading-relaxed">{t('privacy:security.migration_desc')}</p>
              </div>
              <div class="card-neumorphic-flat p-5">
                <h3 class="font-display font-bold text-text-primary mb-1">{t('privacy:security.hardware_binding_title')}</h3>
                <p class="text-xs text-text-secondary leading-relaxed">{t('privacy:security.hardware_binding_desc')}</p>
              </div>
            </div>
          </div>
        </section>

      </div>
    </main>

    <Footer lang={lang} />
  </div>
</MainLayout>

<script>
  const sections = document.querySelectorAll('.content-section');
  const navLinks = document.querySelectorAll('.nav-link');

  function updateActiveLink() {
    let currentId = 'privacy';
    sections.forEach(section => {
      const sectionTop = (section as HTMLElement).offsetTop;
      if (window.scrollY >= sectionTop - 150) {
        currentId = section.getAttribute('id') || 'privacy';
      }
    });

    navLinks.forEach(link => {
      const el = link as HTMLElement;
      el.classList.remove('bg-bg-surface', 'text-accent');
      el.style.boxShadow = 'none';

      if (link.getAttribute('href') === `#${currentId}`) {
        el.classList.add('bg-bg-surface', 'text-accent');
        el.style.boxShadow = 'var(--shadow-neu-icon)';
      }
    });
  }

  window.addEventListener('scroll', updateActiveLink);
  window.addEventListener('load', updateActiveLink);
</script>
