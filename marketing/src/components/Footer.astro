---
// marketing/src/components/Footer.astro
import { getLangFromUrl, useTranslations } from '../utils/i18n';

const { lang: propLang } = Astro.props;
const lang = propLang || Astro.currentLocale || getLangFromUrl(Astro.url);
const langPrefix = lang === 'en' ? '' : `/${lang}`;
const t = useTranslations(lang);
---

<footer class="py-14 mt-8 bg-bg-surface/60">
  <div class="max-w-6xl mx-auto px-6 text-center text-text-secondary flex flex-col items-center">
    <div class="flex items-center justify-center gap-3 mb-5">
      <div class="w-9 h-9 rounded-xl bg-bg-surface flex items-center justify-center" style="box-shadow: var(--shadow-neu-icon)">
        <img src="/pwa-192x192.png" alt="NYX" class="w-5 h-5 rounded-md" />
      </div>
      <span class="font-display text-lg font-bold tracking-tight text-text-primary">NYX</span>
    </div>
    <p class="text-sm font-medium mb-4">
      © {new Date().getFullYear()} NYX. {t('common:nav.terms') || 'All rights reserved'}. <span class="font-bold text-accent">AGPL-3.0</span>.
    </p>

    <div class="flex flex-wrap justify-center items-center gap-x-3 gap-y-2 text-xs font-bold mt-1 mb-8">
      <a href={`${langPrefix}/`} class="hover:text-accent transition-colors tracking-wide">{t('common:nav.home')}</a>
      <span class="text-text-secondary/30">•</span>

      <a href={`${langPrefix}/help`} class="hover:text-accent transition-colors tracking-wide">{t('common:nav.help')}</a>
      <span class="text-text-secondary/30">•</span>

      <a href={`${langPrefix}/commercial`} class="hover:text-accent transition-colors tracking-wide">{t('common:nav.commercial')}</a>
      <span class="text-text-secondary/30">•</span>

      <a href={`${langPrefix}/privacy`} class="hover:text-accent transition-colors tracking-wide">{t('common:nav.privacy')}</a>
      <span class="text-text-secondary/30">•</span>

      <a href={`${langPrefix}/refund`} class="hover:text-accent transition-colors tracking-wide">{t('common:nav.refund')}</a>
      <span class="text-text-secondary/30">•</span>

      <a href={`${langPrefix}/security`} class="hover:text-accent transition-colors tracking-wide">{t('common:nav.security')}</a>
      <span class="text-text-secondary/30">•</span>

      <a href={`${langPrefix}/hall-of-fame`} class="hover:text-accent transition-colors tracking-wide">{t('common:nav.hall_of_fame')}</a>
      <span class="text-text-secondary/30">•</span>

      <a href="https://github.com/h4nzs/nyx-chat" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors tracking-wide">{t('common:nav.source')}</a>
      <span class="text-text-secondary/30">•</span>

      <a href={`${langPrefix}/api-docs`} class="text-accent hover:text-text-primary transition-colors tracking-wide">{t('common:nav.api_docs')}</a>
    </div>

    <p class="text-xs text-text-secondary/60 max-w-3xl mx-auto leading-relaxed italic">
      {t('common:quote')}
    </p>
  </div>
</footer>
