# NYX — EnvironmentFile untuk `nyx-kt-auditor-v2` (auditor pihak ketiga log KT v2, ML-DSA).
#
# Salin ke /etc/nyx/kt-v2/nyx-kt-auditor.env (mode 0600), isi nama + lokasi kunci,
# lalu `systemctl enable --now nyx-kt-auditor-v2` (ops/systemd/README.md).
#
# Nama di sini **harus** punya entri di `api.auditors` pada config log
# (`/etc/nyx/kt-v2/config.yaml`): nilainya adalah kunci publik ML-DSA-65 auditor (1952 byte)
# dalam hex. Nama sendirian tidak berguna — tanda tangan tetap diverifikasi
# terhadap kunci publik itu.

# Nama auditor (label di log operator + kunci untuk `api.auditors`).
NYX_KT_V2_AUDITOR_NAME=nyx-primary-auditor-v2

# Berkas berisi seed ML-DSA-65 auditor: 32 byte hex, mode 0600.
#   openssl rand -hex 32 > /etc/nyx/kt-v2/auditor.key && chmod 600 /etc/nyx/kt-v2/auditor.key
# Baris `api.auditors` untuk config log dicetak alat ini sendiri (tanpa salin manual):
#   /root/nyx-app/server/kt-query/nyx-kt-auditor-v2 -name <nama> -key-file <berkas> -print-public-key
NYX_KT_V2_AUDITOR_KEY_FILE=/etc/nyx/kt-v2/auditor.key

# State auditor (JSON bertanda tangan; dibuat sendiri oleh proses ini).
# Direktori ini WAJIB ada di ReadWritePaths unit.
NYX_KT_V2_AUDITOR_STATE_FILE=/var/lib/nyx/kt-auditor-v2/state.json

# Alamat loopback layanan log (JANGAN pernah diekspos ke publik).
NYX_KT_V2_QUERY_URL=http://127.0.0.1:8089
NYX_KT_V2_AUDITOR_ADDR=127.0.0.1:8087

# Irama kerja. `SIGNATURE_INTERVAL` = seberapa sering auditor menandatangani tree
# head yang sudah ia verifikasi; auditor yang lebih dari 7 hari tidak menandatangani
# akan ditolak klien (`timeAuditorMaxBehind` upstream), jadi jangan lebih dari 24h.
NYX_KT_V2_AUDITOR_INTERVAL=1m
NYX_KT_V2_AUDITOR_SIGNATURE_INTERVAL=1h
NYX_KT_V2_AUDITOR_SIGNATURE_PAGE_SIZE=1000000

# Jumlah update per permintaan `Audit` (maksimum 1000 — batas keras upstream).
NYX_KT_V2_AUDITOR_BATCH_SIZE=1000
