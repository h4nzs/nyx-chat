# NYX — EnvironmentFile untuk `nyx-kt-auditor` (auditor pihak ketiga log KT).
#
# Salin ke /etc/nyx/kt/nyx-kt-auditor.env (mode 0600), isi nama + lokasi kunci,
# lalu `systemctl enable --now nyx-kt-auditor` (ops/systemd/README.md).
#
# Nama di sini **harus** punya entri di `api.auditors` pada config log
# (`/etc/nyx/kt/test_config.yaml`): nilainya adalah kunci publik ed25519 auditor
# dalam hex. Nama sendirian tidak berguna — tanda tangan tetap diverifikasi
# terhadap kunci publik itu.

# Nama auditor (label di log operator + kunci untuk `api.auditors`).
NYX_KT_AUDITOR_NAME=nyx-primary-auditor

# Berkas berisi seed ed25519 auditor: 32 byte hex, mode 0600.
#   openssl rand -hex 32 > /etc/nyx/kt/auditor.key && chmod 600 /etc/nyx/kt/auditor.key
# Baris `api.auditors` untuk config log dicetak alat ini sendiri (tanpa salin manual):
#   /root/nyx-app/server/kt-query/nyx-kt-auditor -name <nama> -key-file <berkas> -print-public-key
NYX_KT_AUDITOR_KEY_FILE=/etc/nyx/kt/auditor.key

# State auditor (JSON bertanda tangan; dibuat sendiri oleh proses ini).
# Direktori ini WAJIB ada di ReadWritePaths unit.
NYX_KT_AUDITOR_STATE_FILE=/var/lib/nyx/kt-auditor/state.json

# Alamat loopback layanan log (JANGAN pernah diekspos ke publik).
NYX_KT_QUERY_URL=http://127.0.0.1:8085
NYX_KT_AUDITOR_ADDR=127.0.0.1:8082

# Irama kerja. `SIGNATURE_INTERVAL` = seberapa sering auditor menandatangani tree
# head yang sudah ia verifikasi; auditor yang lebih dari 7 hari tidak menandatangani
# akan ditolak klien (`timeAuditorMaxBehind` upstream), jadi jangan lebih dari 24h.
NYX_KT_AUDITOR_INTERVAL=1m
NYX_KT_AUDITOR_SIGNATURE_INTERVAL=1h
NYX_KT_AUDITOR_SIGNATURE_PAGE_SIZE=1000000

# Jumlah update per permintaan `Audit` (maksimum 1000 — batas keras upstream).
NYX_KT_AUDITOR_BATCH_SIZE=1000
