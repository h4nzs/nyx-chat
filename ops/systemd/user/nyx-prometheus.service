# NYX — Prometheus (metrik loopback nyx-api + log/auditor KT v2).
# Padanan tingkat-user dari pemasangan /etc/prometheus di docs/10 §10.12, dengan
# path di @NYX_HOME@ supaya tidak butuh root.
#
# Kenapa Prometheus jalan di host yang sama: metrik NYX HANYA didengar di
# loopback (server/src/utils/metricsEndpoint.ts, log KT v2 :9468 dan auditor v2
# lewat NYX_KT_V2_AUDITOR_METRICS_ADDR default 127.0.0.1:9469). Tidak ada port metrik
# yang dibuka ke jaringan, dan nginx tidak mem-proxy /metrics.
#
# Config disalin dari repo (ops/prometheus/) — JANGAN mengedit di sini:
#   install -m 644 ~/nyx-chat/ops/prometheus/prometheus.yml \
#                  ~/nyx-selfhost/prometheus/conf/prometheus.yml
#   install -m 644 ~/nyx-chat/ops/prometheus/alerts.yml \
#                  ~/nyx-selfhost/prometheus/conf/alerts.yml
#   ~/nyx-selfhost/prometheus/bin/promtool check config \
#                  ~/nyx-selfhost/prometheus/conf/prometheus.yml
#   systemctl --user reload nyx-prometheus   # setelah config berubah
[Unit]
Description=NYX Prometheus (scrape loopback nyx-api + nyx-kt-query-v2 + nyx-kt-auditor-v2)
Documentation=file://@NYX_REPO@/deploy/selfhost/README.md
After=nyx-api.service nyx-kt-query-v2.service nyx-kt-auditor-v2.service
Wants=nyx-kt-query-v2.service nyx-kt-auditor-v2.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@NYX_STATE@/prometheus
ExecStart=@NYX_STATE@/prometheus/bin/prometheus \
  --config.file=@NYX_STATE@/prometheus/conf/prometheus.yml \
  --storage.tsdb.path=@NYX_STATE@/prometheus/data \
  --web.listen-address=127.0.0.1:9090 \
  --storage.tsdb.retention.time=15d \
  --storage.tsdb.retention.size=2GB
# SIGHUP = reload config + rules tanpa memutus seri (systemctl --user reload).
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
