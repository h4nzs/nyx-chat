# NYX — layanan log Key Transparency v2 (`nyx-kt-query-v2`, ML-DSA-65).
# Padanan tingkat-user dari `ops/systemd/nyx-kt-query-v2.service` (repo), dengan
# path disesuaikan ke @NYX_HOME@ supaya tidak butuh root.
#
# Sejak 2026-10-28 ini SATU-SATUNYA log KT yang berjalan di mesin ini: layanan
# v1 (`nyx-kt-query`), auditor v1, dan pemeriksa `nyx-kt-check` dipensiunkan
# bersama jalur tulis v1 di server NYX (docs/38). Server hanya menulis lewat
# `KT_V2_SERVER_URL`; `KT_SERVER_URL` diabaikan dan memunculkan peringatan saat
# boot.
#
# WAJIB satu proses: LevelDB memakai flock; dua proses pada `db.file` yang sama
# mati dengan "resource temporarily unavailable". Jangan pernah menjalankan
# salinan kedua (termasuk unit v1 lama) bersamaan.
#
# Semua listener loopback (8089 baca, 8088 tulis gRPC, 8087 auditor gRPC,
# 9468 metrik) — hanya nyx-api di host yang sama yang boleh menyentuhnya.
#
# Tanpa config, service ini gagal start dengan pesan jelas di journal; itu
# memang disengaja (jangan pernah "hidup" tanpa log KT).
[Unit]
Description=NYX Key Transparency v2 log (ML-DSA-65, LevelDB single-owner)
Documentation=file://@NYX_REPO@/deploy/selfhost/README.md
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@NYX_REPO@/server/kt-query
# Flag literal (bukan EnvironmentFile) supaya path tidak berubah tanpa sengaja;
# padanannya di repo memakai NYX_KT_V2_* dari EnvironmentFile, hasil akhirnya
# sama. Ganti `-snapshot-dir` hanya bersama KT_SNAPSHOT_DIR di server/.env —
# kalau tidak, job unggah 03:30 membaca direktori kosong.
ExecStart=@NYX_REPO@/server/kt-query/nyx-kt-query-v2 \
  -config @NYX_STATE@/kt/v2/etc/config.yaml \
  -db @NYX_STATE@/kt/v2/db/tree.db \
  -read-addr 127.0.0.1:8089 \
  -write-addr 127.0.0.1:8088 \
  -auditor-addr 127.0.0.1:8087 \
  -metrics-addr 127.0.0.1:9468 \
  -snapshot-dir @NYX_STATE@/kt/v2/snapshots
Restart=always
RestartSec=3
TimeoutStopSec=20

# Hardening ringan saja: unit user tidak boleh memakai ProtectSystem/ProtectHome
# (path-nya justru di dalam /home).
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
