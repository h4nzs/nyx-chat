# NYX — sidecar PIR dua server (`xor-pir-v1`), unit **user** (self-host `~/nyx-selfhost`).
#
# Unit sistem setara ada di docs/35 Fase 4b (VPS/pm2 tidak memakai ini karena
# sidecar belum di-deploy ke produksi). Mesin selfhost memakai systemd tingkat
# user: `systemctl --user`, tanpa root.
#
# Kenapa proses terpisah: shard PIR menyimpan seluruh direktori dan menjawab
# share biner; ia harus terpisah dari API yang memegang sesi. API hanya
# mem-proxy byte opaque ke loopback (lihat `server/src/routes/pir.ts`).
#
# Butuh DUA instance (role a dan b, host/port berbeda) — satu instance tidak
# cukup: klien menolak jalan tanpa dua server. Detail: `docs/42`.
#
# Pasang:
#   cd ~/nyx-chat/server/pir-sidecar && cargo build --release --locked
#   install -d -m 0750 ~/nyx-selfhost/pir
#   install -m 0600 /path/pir.env ~/nyx-selfhost/pir/pir.env   # lihat di bawah
#   systemctl --user daemon-reload
#   systemctl --user enable --now nyx-pir-sidecar
#   curl -fsS http://127.0.0.1:9470/health
#
# `pir.env` wajib memuat PIR_BIND (loopback), PIR_ROLE (`a` atau `b`),
# PIR_ADMIN_TOKEN (sama dengan `PIR_ADMIN_TOKEN` di server/.env), dan
# PIR_SHARD_DIR (direktori berisi `shard-<n>.bin` + `shard-<n>.json`).
# Tidak ada lagi PIR_MASTER_SECRET/PIR_ARITY/PIR_SNAPSHOT_PATH.
# Shard ditulis builder WP2; sidecar memuatnya saat boot dan menerima
# penggantian per shard lewat `/admin/rebuild`.

[Unit]
Description=NYX PIR sidecar (two-server XOR-PIR, loopback)
Documentation=file://@NYX_REPO@/deploy/selfhost/README.md
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@NYX_REPO@/server
# Env terpisah: sidecar tidak butuh DATABASE_URL/Redis/JWT_SECRET, dan tidak
# boleh mewarisinya dari server/.env.
EnvironmentFile=-@NYX_STATE@/pir/pir.env
ExecStart=@NYX_REPO@/server/pir-sidecar/target/release/pir-service
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
