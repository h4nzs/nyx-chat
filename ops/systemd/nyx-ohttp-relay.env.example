# NYX — relay OHTTP proses terpisah (docs/37 §37.4 P7, docs/10 §10.18).
# Salin ke /etc/nyx/ohttp/nyx-ohttp-relay.env (0600) dan sesuaikan.
#
# Proses ini TIDAK butuh DATABASE_URL, Redis, JWT_SECRET, atau key ring at-rest.
# Kalau salah satunya ditambahkan di sini, ada tanggung jawab yang salah tempat.

# Wajib: gateway OHTTP di API (loopback). Hanya host loopback yang diterima —
# target lain akan membuat relay menjadi open proxy dan proses menolak start.
OHTTP_GATEWAY_TARGET=http://127.0.0.1:4000/api/ohttp/gateway

# Host gateway tambahan yang dipercaya selain loopback (kosong di deployment
# pm2/systemd). Isi HANYA untuk Docker: OHTTP_GATEWAY_TRUSTED_HOSTS=server.
OHTTP_GATEWAY_TRUSTED_HOSTS=

# Listener relay. Default loopback; buka ke publik lewat nginx (`/api/ohttp/relay`),
# JANGAN bind 0.0.0.0 di host biasa. Bind lebar hanya untuk jaringan container,
# dan itu harus disengaja: OHTTP_RELAY_ALLOW_PUBLIC_BIND=1.
OHTTP_RELAY_ALLOW_PUBLIC_BIND=
OHTTP_RELAY_HOST=127.0.0.1
OHTTP_RELAY_PORT=4100

# Batas body amplop (default 8mb, sama dengan gateway) dan rate limit per IP
# (default 120/menit). Rate limit ini satu-satunya penahan abuse di relay.
OHTTP_RELAY_MAX_BODY=8mb
OHTTP_RELAY_RATE_LIMIT=120

NODE_ENV=production
