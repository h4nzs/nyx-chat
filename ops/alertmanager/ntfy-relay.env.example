#
# [docs/10 §10.12] Template EnvironmentFile untuk relay Alertmanager → ntfy.
#
# Pasang (di VPS/self-host, level user):
#   install -d -m 700 ~/nyx-selfhost/alertmanager
#   install -m 600 ops/alertmanager/ntfy-relay.env.example \
#                  ~/nyx-selfhost/alertmanager/ntfy-relay.env
#   # lalu isi NTFY_TOPIC (rahasia: siapa pun yang tahu nama topik bisa MEMBACA
#   # notifikasi, jadi jangan pakai nama yang mudah ditebak)
#
# Topik ada di sini, bukan di alertmanager.yml, supaya berkas Alertmanager tetap
# bebas rahasia dan bisa di-commit (lihat komentar di alertmanager.yml).

# Server ntfy. ntfy.sh = layanan publik tanpa akun (notifikasi lewat di server
# mereka); ganti ke instance sendiri bila isi alert tidak boleh keluar — lihat
# bagian "ntfy self-host" di README.md.
NTFY_URL=https://ntfy.sh

# Topik langganan. WAJIB: tanpa ini relay berhenti dengan kode 2 alih-alih
# berjalan tanpa kanal (notifikasi hilang senyap = lebih buruk daripada mati).
# Buat yang acak, mis.: openssl rand -hex 16
NTFY_TOPIC=ganti-topik-acak-32-hex

# Alamat loopback relay (Alertmanager menunjuk ke sini). Non-loopback DITOLAK.
# 9095, BUKAN 9094: Alertmanager memakai 9094/tcp untuk gossip HA-nya sendiri.
LISTEN_ADDR=127.0.0.1:9095

# Opsional: token Bearer untuk server ntfy yang mewajibkan auth
# (ntfy.sh dengan topik ber-ACL, atau instance sendiri).
# NTFY_TOKEN=
