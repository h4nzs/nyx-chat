# TEMPLATE — `build.sh` menyalin berkas ini ke `Cargo.toml` sambil mengganti
# `__LIBSIGNAL_PATH__` dengan path checkout libsignal (pin docs/30 §30.2:
# `libsignal/rust/keytrans` e8cc2dddd578). Crate libsignal TIDAK di-vendor
# (AGPL-3.0 + workspace besar), jadi Cargo.toml hasil generate tidak di-commit.
[package]
name = "nyx-keytrans-wasm"
version = "0.1.0"
edition = "2021"
license = "AGPL-3.0-or-later"
publish = false

[lib]
crate-type = ["cdylib"]

[dependencies]
# Versi prost WAJIB sama dengan yang dipakai `libsignal-keytrans` (trait
# `Message` berbeda antar versi, jadi prost 0.13 tidak bisa men-decode tipe 0.14).
libsignal-keytrans = { path = "__LIBSIGNAL_PATH__/rust/keytrans" }
prost = "0.14"

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
