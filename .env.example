# Backend
# [docs/10 / R6 2026-10-15] Pengaman /api/admin/cleanup (destruktif: menghapus
# baris, termasuk akun dorman). ADMIN_CLEANUP_SECRET sangat disarankan terpisah
# dari CHAT_SECRET; kosong → fallback CHAT_SECRET + peringatan boot.
# ADMIN_CLEANUP_IP_ALLOWLIST = CSV IP yang boleh memanggilnya; kosong = tanpa
# batasan IP. Diperiksa SEBELUM kunci dibandingkan.
ADMIN_CLEANUP_IP_ALLOWLIST=
ADMIN_CLEANUP_SECRET=
APP_URL=https://api.nyx-app.my.id
# [docs/31 §31.6 fase 3] Rahasia HMAC untuk menurunkan kunci objek backup R2
# (tanpa userId di kunci objek). Sebaiknya nilai independen yang STABIL di
# production; bila kosong, jatuh ke JWT_SECRET (dengan peringatan startup) dan
# rotasi JWT_SECRET akan membuat backup awan lama tak bisa ditemukan lagi.
BACKUP_KEY_SECRET=YOUR-BACKUP-KEY-SECRET
CHAT_SECRET=YOUR-SUPER-SECRET
CORS_ORIGIN=http://localhost:3000
CSRF_SECRET=YOUR-CSRF-SECRET
DATABASE_URL=postgresql://*:@localhost:5432/nyx_app
DIRECT_URL=postgresql://*:@localhost:5432/nyx_app?sslmode=disable
DISCORD_REPORT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR-WEBHOOK-URL
# [docs/28 Tier 0.1] Private key issuer blind RSA grup (base64 PKCS#8).
# WAJIB di production — key TIDAK disimpan di DB (dump DB dulu = bisa memalsukan
# keanggotaan grup). Buat dengan: pnpm --filter nyx-server run issuer-key:generate.
# Rotasi: naikkan GROUP_ISSUER_KEY_VERSION (row publik dibuat otomatis).
GROUP_ISSUER_KEY_PKCS8=
GROUP_ISSUER_KEY_VERSION=1
JWT_SECRET=YOUR-JWT-SECRET
# [R2 2026-10-15] Versi klien minimum yang boleh bicara dengan server ini
# (HTTP 426 CLIENT_TOO_OLD bila klien melaporkan versi lebih kecil). Kosong =
# gerbang mati. Klien yang tidak mengirim header versi selalu lolos, jadi
# naikkan angka ini hanya setelah klien lama sudah tidak dipakai.
MIN_CLIENT_VERSION=
# [docs/28 Tier 0] Pepper untuk hash identifier at-rest (blind index username,
# IP, fingerprint perangkat) + key seal deterministik (Tenant.apiKey, routing).
# WAJIB di production; JANGAN simpan di DB/backup — kalau pepper bocor, dump DB
# bisa dibalik lagi. Rotasi pepper = identifier lama tidak lagi cocok.
NYX_AT_REST_PEPPER=YOUR-RANDOM-PEPPER-32-BYTE
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
TRANSPORT_PORT=33333
CF_ACCOUNT_ID=YOUR-CLOUDFLARE-ACCOUNT-ID
CF_TURN_KEY_ID=YOUR-CLOUDFLARE-TURN-KEY-ID
CF_TURN_API_TOKEN=YOUR-CLOUDFLARE-TURN-API-TOKEN
# STUN milik operator (opsional, dipisah koma). Kosong = tidak ada fallback STUN
# sama sekali; kegagalan TURN menjadi 503/502 yang terlihat (docs/29 §5.7).
ICE_STUN_URLS=stun:turn.example.com:3478
# [docs/30 WS-E(1)] coturn self-host = PRIMER. Setel TURN_STATIC_AUTH_SECRET
# (nilai `static-auth-secret` coturn) + TURN_URLS agar server menerbitkan
# kredensial HMAC time-limited; Cloudflare TURN di bawah hanya cadangan.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_STATIC_AUTH_SECRET=YOUR-COTURN-STATIC-AUTH-SECRET
TURN_TTL=600
# [docs/30 WS-H] Guard burst registrasi per sumber (IP ter-HMAC, bukan IP mentah),
# per instalasi, dan per jaringan (ASN). 'on' = aktif; kosong/off = no-op
# (rollback tanpa deploy logika).
ABUSE_REGISTRATION_GUARD=off
# [docs/30 WS-H] Tabel prefix→ASN LOKAL (CSV dua kolom pertama: `prefix,asn`,
# mis. ekspor GeoLite2-ASN-Blocks-IPv4/6.csv). Kosong = lapisan ASN nonaktif.
# IP mentah tidak pernah disimpan; yang masuk Redis hanya nilai ter-pepper.
ASN_DB_FILE=
# [docs/30 WS-H] 'on' = SEMUA akun baru wajib attestation perangkat keras.
# Heuristik burst sybil per-ASN juga meminta attestation walau ini 'off'.
ABUSE_REQUIRE_ATTESTATION=off
ABUSE_ATTESTATION_FORMATS=packed,tpm,android-key,apple,fido-u2f
ABUSE_ATTESTATION_BLOCKED_AAGUIDS=
# Longgarkan hanya bila operator tahu risikonya (self/none = bukan bukti perangkat).
ABUSE_ATTESTATION_ALLOW_SELF=off
# 'on' = terima attestation `none` (passkey tersinkron Google/Apple, alur default
# Android/iOS). Gate lalu hanya membuktikan authenticator ber-UV, bukan perangkat
# keras; akun hasil jalur ini dibuat dengan isVerified=false. Wajib juga
# menambahkan `none` ke ABUSE_ATTESTATION_FORMATS.
ABUSE_ATTESTATION_ALLOW_NONE=off
# 'on' = terima authenticator `multiDevice` (passkey tersinkron). Berdiri sendiri:
# tanpa ALLOW_NONE, passkey tetap ditolak karena `fmt: none`.
ABUSE_ATTESTATION_ALLOW_SYNCED=off
# 'on' = perangkat yang TIDAK punya authenticator sama sekali (desktop Linux
# tanpa Touch ID/Windows Hello dan tanpa security key) boleh mendaftar tanpa
# bukti. Akun tersebut isVerified=false (upload & pencarian luas tetap tertutup),
# dan heuristik burst sybil per-ASN TIDAK bisa memakai jalur ini.
ABUSE_ATTESTATION_ALLOW_UNATTESTED=off
# Rantai x5c wajib terverifikasi (tersambung, masih berlaku, berakhir di root
# yang dipin ATAU di sertifikat self-signed yang dipin persis). 'on' = lewati
# pemeriksaan itu — hanya untuk test; sertifikat self-signed buatan siapa pun
# akan masuk tier "hardware".
ABUSE_ATTESTATION_ALLOW_UNVERIFIED_CHAIN=off
# Fingerprint SHA-256 root attestation yang dipercaya (dipisah koma, mis.
# `AA:BB:...`). Cocok untuk root yang IKUT di x5c atau sertifikat self-signed
# yang dipin persis; tidak cukup bila x5c berhenti di intermediate.
ABUSE_ATTESTATION_ROOTS=
# Bundle PEM (satu/lebih sertifikat) root attestation vendor. Inilah yang
# memungkinkan rantai perangkat nyata diverifikasi ketika x5c hanya berisi
# leaf (+ intermediate): TPM/Windows Hello, Android Key Attestation, packed
# YubiKey, dan `apple`. Lihat ops/attestation/README.md.
ABUSE_ATTESTATION_ROOTS_FILE=
# Metadata bundle root dari `node scripts/attestation-roots.mjs refresh`
# (default: <ABUSE_ATTESTATION_ROOTS_FILE>.meta.json). Dipakai peringatan boot
# + alert untuk nextUpdate MDS yang lewat dan root kedaluwarsa.
ABUSE_ATTESTATION_ROOTS_META=
# `fmt: 'tpm'` wajib ber-EKU AIK TPM (2.23.133.8.3). 'on' = tidak diwajibkan.
ABUSE_ATTESTATION_ALLOW_NO_AIK_EKU=off
# [docs/30 WS-A / docs/32] Endpoint gRPC test-update log Key Transparency
# (loopback, mis. http://127.0.0.1:8081). Kosong = penulisan log nonaktif.
KT_SERVER_URL=
# [docs/35 §35.7 Fase 7] Log KT v2 (ML-DSA). Bila diisi, setiap entri ditulis ke
# v1 DAN v2 (dual-write) selama transisi. Satu log gagal tidak membatalkan yang
# lain; metrik terpisah: nyx_kt_v2_writes_total / nyx_kt_v2_last_success...
KT_V2_SERVER_URL=
KT_TIMEOUT_MS=5000
# [docs/32 §32.8] Layanan baca KT NYX (`server/kt-query`, loopback, mis.
# http://127.0.0.1:8085). Kosong = /api/keys/kt/* menjawab 503 KT_QUERY_DISABLED
# (klien jatuh ke TOFU, terlihat di metrik nyx_kt_queries_total{result="disabled"}).
# Saat cutover v2, arahkan ke layanan v2 (http://127.0.0.1:8089); klien memilih
# ABI dari `abiVersion` di /api/keys/kt/config.
KT_QUERY_URL=
KT_QUERY_TIMEOUT_MS=5000
# [docs/10 §10.13] Arsip snapshot log KT (`nyx-kt-query` → `NYX_KT_SNAPSHOT_DIR`,
# `NYX_KT_SNAPSHOT_INTERVAL`, `NYX_KT_SNAPSHOT_KEEP`) diunggah ke R2 oleh server
# tiap 03:30, retensi 30 hari. Kosong = snapshot tidak keluar dari VPS.
# Saat cutover, arahkan ke arsip v2 (`/var/lib/nyx/kt-v2-snapshots`).
KT_SNAPSHOT_DIR=
R2_ACCESS_KEY_ID=YOUR-R2-ACCESS-KEY-ID
R2_ACCOUNT_ID=YOUR-R2-ACCOUNT-ID
R2_BUCKET_NAME=YOUR-R2-BUCKET-NAME
R2_PUBLIC_DOMAIN=YOUR-R2-PUBLIC-DOMAIN
R2_SECRET_ACCESS_KEY=YOUR-R2-SECRET-ACCESS-KEY
# Observability (docs/10 §10.12, docs/30 WS-G). Loopback-only; 0 = matikan exporter.
METRICS_HOST="127.0.0.1"
METRICS_PORT=9464
REDIS_URL="redis://127.0.0.1:6379"
TURNSTILE_SECRET_KEY=YOUR-TURNSTILE-SECRET-KEY
UPLOAD_DIR=uploads // optional if the user upload saved in localstorage or you dont have any cf storage bucket (you might have to change the upload logic code to the localstorage e.g attachment, user/group avatar, and story), default is "uploads"
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_SUBJECT="mailto:YOUR@MAIL.COM"

# Payments (crypto-only — NOWPayments)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=


# Frontend
VITE_API_URL=http://localhost:4000
VITE_APP_SECRET=
VITE_VAPID_PUBLIC_KEY=
# WebTransport origin (dev: http://localhost:33333 — port sidecar). Kosong =
# diturunkan dari VITE_API_URL (http→https). Lihat docs/02 §2.3 + docs/06.
VITE_TRANSPORT_URL=http://localhost:33333
# Pin sertifikat sidecar untuk dev (lihat docs/08 §8.3); wajib bila memakai
# WebTransport di localhost — ambil hash dari output startup sidecar.
VITE_TRANSPORT_CERT_HASH= # Required for WebTransport on localhost (get it from server/transport-sidecar output)
# Transports socket.io saat fallback ke WSS, dipisah koma (mis. `websocket,polling`).
# docs/10 §10.12 memakai `VITE_WSS_TRANSPORTS=websocket` untuk build di belakang
# proxy tanpa polling.
VITE_WSS_TRANSPORTS=websocket,polling
# `1` = langsung pakai WSS tanpa mencoba WebTransport (self-host tanpa sidecar,
# atau E2E yang tidak menjalankan uplink QUIC). Kosong = WT dulu, fallback WSS.
VITE_FORCE_WSS=
INDEXNOW_API_KEY=
# [docs/33 §33.10] Ratchet jalur v2 (braid SPQR)
# Kill switch operator: memaksa SEMUA pengiriman ke jalur v1 beku (state braid
# tidak dihapus, jadi pesan v2 yang sudah lewat tetap terbaca).
VITE_SPQR_FORCE_V1=
# Override uji/E2E saja: perlakukan kapabilitas relay `spqr-ratchet` seolah
# dinegosiasikan. HANYA dihormati di build DEV (Vite dev). Dipakai spec
# `web/e2e/spqr.spec.ts` di mesin tanpa sidecar WebTransport.
VITE_SPQR_FORCE_V2=
# [docs/35] PQ-only sejak 2026-10-23: jalur v2 selalu aktif; VITE_PQ_V2
# tidak lagi mengubah perilaku (dibiarkan untuk kompatibilitas template lama).
# VITE_PQ_V2=1
# [docs/35 Fase 3] OHTTP (RFC 9458) — DEFAULT MATI di server dan klien.
# Router /api/ohttp tidak dipasang sama sekali bila OHTTP_ENABLED kosong.
# Generate kunci: pnpm --filter nyx-server run ohttp-key:generate
# (private key hanya boleh hidup di .env server, jangan masuk repo).
OHTTP_ENABLED=
OHTTP_PRIVATE_KEY=
OHTTP_PUBLIC_KEY=
# Rotasi dua slot (opsional): dipublikasikan bersama kunci aktif sebagai key id 2.
# Isi BERDUA atau tidak sama sekali; separuh slot = boot gagal.
OHTTP_NEXT_PRIVATE_KEY=
OHTTP_NEXT_PUBLIC_KEY=
# URL gateway internal yang dituju relay (default loopback /api/ohttp/gateway).
OHTTP_RELAY_TARGET=
# `on` (default) = klien mengambil token 120 dtk lalu menaruhnya di amplop.
# `off` = klien tidak mengambil token; /relay wajib auth+CSRF dan server
# mencetak token di relay. Hanya untuk relay loopback/same-host.
OHTTP_TOKEN_MODE=
VITE_OHTTP_ENABLED=
VITE_OHTTP_RELAY_URL=
# Harus sama dengan OHTTP_TOKEN_MODE di server.
VITE_OHTTP_TOKEN_MODE=
# [docs/35 Fase 4a] OPRF blind index pencarian (ristretto255-SHA512).
# Default MATI: POST /api/users/search/oprf menjawab 503 sampai cutover penuh.
# Seed default = HMAC(NYX_AT_REST_PEPPER, "NYX_OPRF_SEED_V1"); jangan ganti
# setelah ada akun, karena index yang tersimpan tidak akan cocok lagi.
PIR_OPRF_ENABLED=
# Klien harus menyalakan ini bersamaan dengan PIR_OPRF_ENABLED di server.
VITE_PIR_OPRF_ENABLED=
# Opsional, base64url tepat 32 byte, untuk memisahkan seed OPRF dari pepper.
NYX_OPRF_SEED=
# [docs/35 Fase 4b] PIR v1 (ChalametPIR) — DEFAULT MATI.
# API hanya proxy ke sidecar loopback; tidak ada kripto PIR di proses Node.
# Jalankan `server/pir-sidecar` (pir-service) sebelum menyalakan PIR_ENABLED.
PIR_ENABLED=
PIR_SERVICE_URL=http://127.0.0.1:9470
# Sidecar: token admin rebuild, seed stabil per epoch, dan batas entri.
PIR_BIND=127.0.0.1:9470
PIR_ADMIN_TOKEN=
PIR_MASTER_SECRET=
PIR_ARITY=3
PIR_MAX_ENTRIES=1000000
# Snapshot builder (`pnpm --filter nyx-server run pir:snapshot`).
PIR_RECORD_BYTES=2048
PIR_SNAPSHOT_PATH=
PIR_EPOCH=
# [docs/35] Credential anonim/group (Fase 5–6) DIHAPUS 2026-10-23.
# Tidak ada /api/credentials/* dan VITE_ANON_CREDENTIALS tidak dipakai.
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
